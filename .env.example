# Content generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Brand defaults
BRAND_NAME=My Brand
BRAND_VOICE=friendly, concise, value-driven
BRAND_LANGUAGE=ar

# Meta Graph API (Facebook Page + Instagram Business account)
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=
META_API_VERSION=v21.0

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=

# Runtime
DATABASE_URL=sqlite:///./marketing_agent.db
TIMEZONE=UTC
PUBLISHING_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=30
MAX_PUBLISH_ATTEMPTS=3
